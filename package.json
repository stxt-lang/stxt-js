{
  "name": "@stxt-lang/core",
  "version": "0.14.1",
  "description": "Parser and schema validator for STXT, an indentation-based structured-text format.",
  "main": "out/all.js",
  "types": "out/all.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "out/all.js",
    "out/all.d.ts",
    "out/core",
    "out/discovery",
    "out/exceptions",
    "out/processors",
    "out/runtime",
    "out/schema",
    "out/template",
    "!out/**/*.js.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "pretest": "npm run build && npm run lint",
    "test": "mocha \"out/test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stxt-lang/stxt-js.git"
  },
  "keywords": [
    "stxt",
    "parser",
    "schema",
    "validation",
    "structured text",
    "indentation",
    "markup",
    "text format",
    "dsl"
  ],
  "author": "Joan Costa Mombiela <joan.costa.mombiela@gmail.com>",
  "license": "MIT",
  "homepage": "https://stxt.dev",
  "bugs": {
    "url": "https://github.com/stxt-lang/stxt-js/issues"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "mocha": "^11.7.5",
    "typescript": "^5.5.4"
  }
}
